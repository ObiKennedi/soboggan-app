{
  "expo": {
    "name": "Soboggan",
    "slug": "soboggan-app",
    "scheme": "soboggan",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/icon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#0F1F3D"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sobogganmanagement.app",
      "config": {
        "googleSignIn": {
          "reservedClientId": "com.googleusercontent.apps.YOUR_IOS_CLIENT_ID"
        }
      }
    },
    "android": {
      "package": "com.sobogganmanagement.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F1F3D"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.YOUR_IOS_CLIENT_ID"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "apiBaseUrl": "http://10.227.222.149:4000/api/v1",
      "googleWebClientId": "1073775630601-svklvrn1s5aamdsirel55k994gh72cme.apps.googleusercontent.com",
      "pusherKey": "d4bd70c0d2e23cf78ac1",
      "pusherCluster": "eu"
    }
  }
}