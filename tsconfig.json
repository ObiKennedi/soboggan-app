{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src",
    "App.tsx"
  ],
  "exclude": [
    "src/app",
    "src/components/animated-icon*",
    "src/components/app-tabs*",
    "src/components/external-link*",
    "src/components/ui",
    "src/components/web-badge*",
    "src/hooks"
  ]
}